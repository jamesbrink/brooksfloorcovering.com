---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import { serviceAreaCitiesSchema } from '../../data/navigation';
import FAQ from '../../components/FAQ.astro';

const faqs = [
  {
    question: 'What is the difference between ceramic and porcelain tile?',
    answer:
      'Porcelain tile is denser, harder, and more moisture-resistant than ceramic tile because it is fired at higher temperatures. Porcelain is better suited for high-traffic and outdoor areas, while ceramic works well in low- to moderate-traffic spaces like bathrooms and backsplashes. Both are durable and low-maintenance options.',
  },
  {
    question: 'How often should grout be sealed?',
    answer:
      'Grout should be sealed every one to two years depending on the type of grout and the amount of traffic and moisture exposure. Sealing grout protects against staining, mold, and moisture penetration, helping maintain the appearance and integrity of your tile floor.',
  },
  {
    question: 'How long does tile flooring installation take?',
    answer:
      'A typical tile floor installation for a single room takes two to three days including preparation, tile setting, grouting, and cleanup. Larger projects such as full bathrooms or multiple rooms may take four to seven days. We provide a detailed timeline during your free estimate.',
  },
  {
    question: 'Is natural stone tile a good choice for kitchens?',
    answer:
      'Natural stone tile such as marble, travertine, and slate can be an excellent choice for kitchens when properly sealed. Stone requires more maintenance than porcelain but offers unique beauty and character. We help clients choose the right stone type based on their kitchen use and lifestyle.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Tile Flooring Installation',
      description:
        'Expert tile flooring installation in Phoenix. Ceramic, porcelain, and natural stone tile for homes and businesses.',
      provider: {
        '@type': 'HomeAndConstructionBusiness',
        '@id': 'https://brooksfloorcovering.com/#business',
      },
      areaServed: serviceAreaCitiesSchema,
      serviceType: 'Tile Flooring Installation',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brooksfloorcovering.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://brooksfloorcovering.com/services/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Tile Flooring',
          item: 'https://brooksfloorcovering.com/services/tile/',
        },
      ],
    },
    {
      '@type': 'HowTo',
      name: 'Tile Flooring Installation Process',
      description:
        'Our proven 6-step tile installation process ensures lasting results and exceptional craftsmanship.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Consultation & Design Selection',
          text: 'We begin by understanding your vision, lifestyle, and space. Our team helps you select the right tile material, size, color, and layout to match your needs and aesthetic goals.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Site Preparation',
          text: 'We inspect and prepare the subfloor to ensure it is clean, level, and structurally sound, creating a solid foundation for your tile.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Layout & Planning',
          text: 'Before installation begins, we carefully plan the tile layout to ensure balanced spacing, clean lines, and optimal visual appeal.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Professional Installation',
          text: 'Using industry-best techniques and materials, our skilled installers place each tile with precision, ensuring consistent spacing and alignment.',
        },
        {
          '@type': 'HowToStep',
          position: 5,
          name: 'Grouting & Finishing',
          text: 'Once tiles are set, grout is applied to secure and seal the floor. We finish with detailed cleanup and final inspection to ensure every detail meets our quality standards.',
        },
        {
          '@type': 'HowToStep',
          position: 6,
          name: 'Final Walkthrough',
          text: 'We review the completed floor with you, answer care questions, and make sure you are fully satisfied with the result.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<Layout
  title="Tile Flooring Installation Phoenix | Brooks Floor Covering"
  description="Expert tile flooring installation in Phoenix. Ceramic, porcelain, and natural stone tile for homes and businesses. Free estimates — call (623) 688-8422."
  jsonLd={jsonLd}
  ogImage="/images/tile-custom-shower-natural-stone.jpg"
>
  <Navigation />

  <Hero
    title="Tile Flooring in Phoenix, AZ"
    subtitle="Timeless, durable, and endlessly versatile tile flooring for homes and businesses across the Greater Phoenix Area."
    compact={true}
  />

  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services' },
      { label: 'Tile Flooring' },
    ]}
  />

  <main>
    <!-- Introduction -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center gap-12 max-w-6xl mx-auto">
          <div class="md:w-1/2">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Tile Flooring Solutions
            </p>
            <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
              Expert Tile Installation for Every Space
            </h2>
            <p class="text-neutral-700 leading-relaxed text-lg mb-4">
              Timeless, durable, and endlessly versatile, tile flooring is one of the smartest
              investments you can make for your home or business. Whether your style leans modern
              and minimal or warm and traditional, tile offers a perfect balance of performance and
              design that stands the test of time.
            </p>
          </div>
          <div class="md:w-1/2">
            <Image
              src="/images/tile-large-format-great-room.jpg"
              alt="Large-format tile flooring installed across a great room"
              class="rounded-lg shadow-lg w-full"
              width={960}
              height={640}
              inferSize
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Tile -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Benefits
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">Why Choose Tile Floors?</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold mb-3 text-neutral-800">Exceptional Durability</h3>
              <p class="text-neutral-700 leading-relaxed text-sm">
                Tile is built to last. Resistant to scratches, dents, moisture, and heavy foot
                traffic, tile floors are ideal for high-use areas like kitchens, bathrooms,
                entryways, and commercial spaces. With proper installation and care, tile can last
                for decades.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold mb-3 text-neutral-800">
                Low Maintenance & Easy Care
              </h3>
              <p class="text-neutral-700 leading-relaxed text-sm">
                Tile floors are incredibly easy to maintain. Regular sweeping and occasional mopping
                keep them looking new. Unlike other flooring options, tile doesn't trap allergens,
                dust, or odors, making it a great choice for healthier indoor spaces.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold mb-3 text-neutral-800">Precision & Clean Finish</h3>
              <p class="text-neutral-700 leading-relaxed text-sm">
                Tile flooring delivers crisp lines, defined edges, and a clean, intentional finish
                that elevates the overall look of a space. When installed correctly, tile creates a
                sense of order and craftsmanship that other flooring types can't replicate.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Functional & Versatile -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div>
              <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
                Performance
              </p>
              <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
                Functional & Versatile
              </h2>
              <p class="text-neutral-700 leading-relaxed mb-4">
                Tile flooring is as functional as it is beautiful. Available in ceramic, porcelain,
                and natural stone, tile can be customized to meet the demands of nearly any space.
                Slip-resistant finishes, varied thicknesses, and strength ratings allow tile to
                perform in residential, commercial, and outdoor environments with confidence.
              </p>
              <p class="text-neutral-700 leading-relaxed">
                From busy households to high-traffic retail spaces, tile delivers reliable
                performance without sacrificing style.
              </p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
                Design
              </p>
              <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">Uniquely Yours</h2>
              <p class="text-neutral-700 leading-relaxed mb-4">
                One of tile's greatest advantages is its design flexibility. Choose from an endless
                array of colors, patterns, textures, and sizes. Tile can mimic the look of natural
                stone or hardwood, create bold geometric patterns, or provide a clean, seamless
                modern finish.
              </p>
              <p class="text-neutral-700 leading-relaxed">
                Layout options like herringbone, chevron, stacked, or staggered patterns allow you
                to create a truly one-of-a-kind space that reflects your personal style.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Installation Process -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Our Process
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Our Tile Installation Process
            </h2>
            <p class="text-neutral-700 leading-relaxed mt-4 max-w-2xl mx-auto">
              We believe a beautiful tile floor starts with expert planning and precise
              installation. Our proven process ensures lasting results and exceptional
              craftsmanship.
            </p>
          </div>

          <div class="space-y-8">
            <div class="flex gap-6">
              <div
                class="flex-shrink-0 w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
              >
                1
              </div>
              <div>
                <h3 class="text-xl font-bold text-brand-dark mb-2">
                  Consultation & Design Selection
                </h3>
                <p class="text-neutral-700 leading-relaxed">
                  We begin by understanding your vision, lifestyle, and space. Our team helps you
                  select the right tile material, size, color, and layout to match your needs and
                  aesthetic goals.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div
                class="flex-shrink-0 w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
