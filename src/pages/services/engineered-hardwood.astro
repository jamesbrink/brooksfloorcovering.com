                alt="Open kitchen with a vaulted ceiling and new wide plank flooring"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                After: wide plank installed
              </figcaption>
            </figure>
          </div>

          <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-4 text-center">
            Finished Floors
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <figure>
              <Image
                src="/images/hardwood-handscraped-plank-travertine-transition.jpg"
                alt="Handscraped hardwood plank meeting a travertine tile floor"
