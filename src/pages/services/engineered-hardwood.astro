            </figure>
            <figure>
              <Image
                src="/images/hardwood-handscraped-plank-long-arched-hallway.jpg"
                alt="Handscraped plank flooring running down a long arched hallway"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                A long hallway, one continuous run
              </figcaption>
            </figure>
            <figure>
              <Image
