                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">Warm oak hallway</figcaption>
            </figure>
          </div>

          <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-2 text-center">
            Dark Wide-Plank, Furnished Rooms
          </h3>
          <p class="text-neutral-600 mb-4 text-center">
            Deep brown wide planks through a living room and kitchen, shown after the furniture
            moved in.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <figure>
              <Image
                src="/images/hardwood-dark-wide-plank-living-room-furnished.jpg"
                alt="Dark wide-plank hardwood floor in a furnished living room open to a kitchen"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Living room and kitchen, one continuous floor
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/hardwood-dark-wide-plank-kitchen-living-bar-stools.jpg"
                alt="Dark wide-plank hardwood floor running from a kitchen bar into a living room"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Kitchen bar into the living room
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/hardwood-weathered-wide-plank-kitchen-stainless.jpg"
                alt="Weathered-look wide-plank hardwood in a kitchen beside stainless appliances"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Weathered-look plank in the kitchen
              </figcaption>
            </figure>
          </div>
        </div>

        <div class="max-w-4xl mx-auto mt-16">
          <h3 class="text-xl font-semibold text-neutral-800 mb-4 text-center">Before and After</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <figure>
              <Image
                src="/images/hardwood-before-carpet-removal-living-room.jpg"
                alt="Living room with carpet pulled back to the concrete slab"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
