---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import { serviceAreaCitiesSchema } from '../../data/navigation';
import FAQ from '../../components/FAQ.astro';

const faqs = [
  {
    question: 'What is the difference between solid hardwood and engineered wood flooring?',
    answer:
      'Solid hardwood is made from a single piece of wood and can be sanded and refinished multiple times. Engineered wood has a real wood veneer over a plywood core, providing superior stability in areas with temperature and humidity changes. Engineered wood can be installed over concrete subfloors and is better suited for basements and radiant heat systems.',
  },
  {
    question: 'Can engineered hardwood be refinished?',
    answer:
      'Yes, most engineered hardwood can be refinished one to three times depending on the thickness of the wood veneer layer. Products with thicker veneers allow more sanding and refinishing over the life of the floor. Solid hardwood can typically be refinished more times than engineered wood.',
  },
  {
    question: 'What wood species is the most durable for flooring?',
    answer:
      'Hickory is one of the hardest and most durable domestic wood species for flooring, followed by maple and white oak. Exotic woods like Brazilian cherry and Santos mahogany are even harder. For high-traffic areas, we recommend species with higher Janka hardness ratings to resist dents and scratches.',
  },
  {
    question: 'Can engineered hardwood be installed in a basement?',
    answer:
      'Yes, engineered hardwood is well-suited for basements because its layered construction resists expansion and contraction from moisture and temperature changes. We recommend floating or glue-down installation methods over concrete subfloors. Proper moisture testing and mitigation are performed before installation to ensure long-term performance.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Engineered Hardwood Flooring Installation',
      description:
        'Engineered hardwood and solid wood floor installation in Phoenix. Oak, maple, hickory, walnut and more.',
      provider: {
        '@type': 'HomeAndConstructionBusiness',
        '@id': 'https://brooksfloorcovering.com/#business',
      },
      areaServed: serviceAreaCitiesSchema,
      serviceType: 'Engineered Hardwood Flooring Installation',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brooksfloorcovering.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://brooksfloorcovering.com/services/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Engineered Hardwood',
          item: 'https://brooksfloorcovering.com/services/engineered-hardwood/',
        },
      ],
    },
    {
      '@type': 'HowTo',
      name: 'Wood Flooring Installation Process',
      description:
        'Our detailed wood flooring installation process ensures beauty, performance, and longevity.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Consultation & Selection',
          text: 'We help you choose the right wood type, species, finish, and installation method based on your space and lifestyle.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Subfloor Preparation',
          text: 'The subfloor is inspected, cleaned, leveled, and moisture-tested to ensure proper installation.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Acclimation',
          text: "Wood flooring is allowed to adjust to the room's environment before installation to prevent warping and gaps.",
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Installation',
          text: 'The floor is installed using the appropriate method for your product and subfloor: nail-down, glue-down, or floating installation.',
        },
        {
          '@type': 'HowToStep',
          position: 5,
          name: 'Finishing (if applicable)',
          text: 'Unfinished floors are sanded, stained, and sealed on-site for a custom look.',
        },
        {
          '@type': 'HowToStep',
          position: 6,
          name: 'Final Inspection & Care Guidance',
          text: 'We ensure everything meets our standards and provide maintenance tips to protect your investment.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<Layout
  title="Engineered Hardwood Flooring Phoenix | Brooks Floor Covering"
  description="Engineered hardwood and solid wood floor installation in Phoenix. Oak, maple, hickory, walnut and more. Free estimates — call (623) 688-8422."
  jsonLd={jsonLd}
  ogImage="/images/site-brooks-team-flooring-project.jpg"
>
  <Navigation />

  <Hero
    title="Engineered & Hardwood Flooring in Phoenix, AZ"
    subtitle="Natural warmth, character, and lasting value for homes and commercial interiors across the Greater Phoenix Area."
    compact={true}
  />

  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services' },
      { label: 'Engineered Hardwood' },
    ]}
  />

  <main>
    <!-- Introduction -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center gap-12 max-w-6xl mx-auto">
          <div class="md:w-1/2">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Wood Flooring Solutions
            </p>
            <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
              Professional Wood Floor Installation
            </h2>
            <p class="text-neutral-700 leading-relaxed text-lg">
              Wood flooring brings warmth, character, and lasting value to any space. Whether you
              choose solid hardwood or engineered wood, these floors combine natural beauty with
              durability and performance, making them a timeless choice for homes and commercial
              interiors alike.
            </p>
          </div>
          <div class="md:w-1/2">
            <Image
              src="/images/hardwood-stairs-landing-treads.jpg"
              alt="Hardwood stairs and landing with finished treads"
              class="rounded-lg shadow-lg w-full"
              width={960}
              height={640}
              inferSize
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Wood -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Benefits
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Why Choose Wood Flooring?
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold mb-3 text-neutral-800">
                Timeless Beauty & Unique Character
              </h3>
              <p class="text-neutral-700 leading-relaxed text-sm">
                No two wood floors are exactly alike. Natural grain patterns, color variations, and
                knots give every floor its own personality. From rustic charm to sleek modern
                elegance, wood flooring adapts beautifully to any design style.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold mb-3 text-neutral-800">Long-Lasting Durability</h3>
              <p class="text-neutral-700 leading-relaxed text-sm">
                High-quality wood floors are built to last. With proper care, hardwood can last for
                decades and can often be refinished multiple times, extending its life even further.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold mb-3 text-neutral-800">Increased Home Value</h3>
              <p class="text-neutral-700 leading-relaxed text-sm">
                Wood flooring is a sought-after feature that adds real value to your property. It's
                a smart investment that enhances both aesthetics and resale appeal.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold mb-3 text-neutral-800">Comfort & Performance</h3>
              <p class="text-neutral-700 leading-relaxed text-sm">
                Wood floors feel solid underfoot, improve indoor air quality by reducing allergens,
                and work well in a variety of spaces. Engineered wood, in particular, offers
                enhanced stability in areas with fluctuating humidity.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Solid vs Engineered -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Know the Difference
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Solid Hardwood vs. Engineered Wood
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-neutral-50 rounded-lg p-8 border border-neutral-200">
              <h3 class="text-xl font-bold text-brand-dark mb-4">Solid Hardwood Flooring</h3>
              <p class="text-neutral-700 leading-relaxed">
                Solid hardwood is made from a single piece of wood, offering unmatched authenticity
                and longevity. It can be sanded and refinished multiple times, making it ideal for
                long-term use in living rooms, bedrooms, and dining areas.
              </p>
            </div>
            <div class="bg-neutral-50 rounded-lg p-8 border border-neutral-200">
              <h3 class="text-xl font-bold text-brand-dark mb-4">Engineered Wood Flooring</h3>
              <p class="text-neutral-700 leading-relaxed">
                Engineered wood consists of a real wood veneer layered over a high-performance
                plywood core. This construction provides superior stability, making it suitable for
                basements, concrete subfloors, and areas with moisture or temperature changes.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Installation Process -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Our Process
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Wood Flooring Installation Process
            </h2>
            <p class="text-neutral-700 leading-relaxed mt-4 max-w-2xl mx-auto">
              Installing a wood floor is a detailed process that ensures beauty, performance, and
              longevity.
            </p>
          </div>

          <div class="space-y-8">
            <div class="flex gap-6">
              <div
                class="flex-shrink-0 w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
              >
                1
              </div>
              <div>
                <h3 class="text-xl font-bold text-brand-dark mb-2">Consultation & Selection</h3>
                <p class="text-neutral-700 leading-relaxed">
                  We help you choose the right wood type, species, finish, and installation method
                  based on your space and lifestyle.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div
                class="flex-shrink-0 w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
              >
                2
              </div>
              <div>
                <h3 class="text-xl font-bold text-brand-dark mb-2">Subfloor Preparation</h3>
                <p class="text-neutral-700 leading-relaxed">
                  The subfloor is inspected, cleaned, leveled, and moisture-tested to ensure proper
                  installation.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div
                class="flex-shrink-0 w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
              >
                3
              </div>
              <div>
                <h3 class="text-xl font-bold text-brand-dark mb-2">Acclimation</h3>
                <p class="text-neutral-700 leading-relaxed">
                  Wood flooring is allowed to adjust to the room's environment before installation
                  to prevent warping and gaps.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div
                class="flex-shrink-0 w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
              >
                4
              </div>
              <div>
                <h3 class="text-xl font-bold text-brand-dark mb-2">Installation</h3>
                <p class="text-neutral-700 leading-relaxed">
                  The floor is installed using the appropriate method for your product and subfloor:
                  nail-down, glue-down, or floating installation.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div
                class="flex-shrink-0 w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
              >
                5
              </div>
              <div>
                <h3 class="text-xl font-bold text-brand-dark mb-2">Finishing (if applicable)</h3>
                <p class="text-neutral-700 leading-relaxed">
                  Unfinished floors are sanded, stained, and sealed on-site for a custom look.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div
                class="flex-shrink-0 w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
              >
                6
              </div>
              <div>
                <h3 class="text-xl font-bold text-brand-dark mb-2">
                  Final Inspection & Care Guidance
                </h3>
                <p class="text-neutral-700 leading-relaxed">
                  We ensure everything meets our standards and provide maintenance tips to protect
                  your investment.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="max-w-4xl mx-auto mt-16">
          <h3 class="text-xl font-semibold text-neutral-800 mb-2 text-center">
            Wide-Plank Oak, Finished Rooms
          </h3>
          <p class="text-neutral-600 mb-4 text-center">
            Long, wide planks in warm oak tones through great rooms, kitchens, halls and stairs.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <figure>
              <Image
                src="/images/hardwood-wide-plank-oak-fireplace-hearth.jpg"
                alt="Wide-plank oak floor in multiple tones running to a fireplace hearth"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Wide plank to the hearth
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/hardwood-light-oak-great-room-sunlight.jpg"
                alt="Light oak wide-plank floor in a great room with sunlight across the planks"
