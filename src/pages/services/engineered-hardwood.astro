                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                After: engineered plank installed
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/hardwood-before-subfloor-prep-wide.jpg"
                alt="Bare concrete subfloor before hardwood installation"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">Before: bare subfloor</figcaption>
            </figure>
            <figure>
              <Image
                src="/images/hardwood-kitchen-navy-island-wide.jpg"
