---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import { serviceAreaCitiesSchema } from '../../data/navigation';
import FAQ from '../../components/FAQ.astro';

const faqs = [
  {
    question: 'What is the difference between matte, satin, and high-gloss polished concrete?',
    answer:
      'The difference is in the level of sheen achieved during the polishing process. Matte finishes have a subtle, natural look with minimal reflection. Satin finishes offer moderate sheen for a balanced appearance. High-gloss finishes produce a mirror-like reflective surface. The level of sheen is determined by the grit of diamond tooling used in the final polishing passes.',
  },
  {
    question: 'Can existing concrete be polished, or does it need to be new?',
    answer:
      'Both existing and new concrete slabs can be polished. Existing slabs may require additional preparation such as removing old coatings, adhesives, or surface imperfections before polishing. The condition of the existing concrete affects the final appearance, but our team evaluates every slab during the free estimate to determine the best approach.',
  },
  {
    question: 'How often does polished concrete need to be resealed?',
    answer:
      'Polished concrete typically needs resealing every three to five years depending on foot traffic, use, and maintenance. High-traffic commercial spaces may need more frequent maintenance. The densifier applied during the polishing process penetrates the concrete permanently, while the surface sealer provides additional protection that is renewed periodically.',
  },
  {
    question: 'Is polished concrete slippery when wet?',
    answer:
      'Polished concrete has similar slip resistance to other hard surface flooring when dry. When wet, higher gloss levels can be more slippery. Anti-slip treatments or lower sheen levels can be specified for areas where wet conditions are expected. We help clients choose the appropriate finish level based on the intended use of the space.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Polished Concrete Flooring',
      description:
        'Professional polished concrete flooring in Phoenix. Matte to high-gloss finishes for homes, offices, and commercial spaces.',
      provider: {
        '@type': 'HomeAndConstructionBusiness',
        '@id': 'https://brooksfloorcovering.com/#business',
      },
      areaServed: serviceAreaCitiesSchema,
      serviceType: 'Polished Concrete Flooring',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brooksfloorcovering.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://brooksfloorcovering.com/services/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Polished Concrete',
          item: 'https://brooksfloorcovering.com/services/polished-concrete/',
        },
      ],
    },
    {
      '@type': 'HowTo',
      name: 'Polished Concrete Flooring Process',
      description:
        'Our professional polished concrete process transforms existing concrete slabs into durable, beautiful finished floors.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Surface Preparation',
          text: 'The existing concrete slab is inspected and prepared. Any coatings, adhesives, or imperfections are removed to create a clean, even base.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Grinding',
          text: 'Industrial diamond grinders are used to progressively grind the surface. This step smooths the concrete and exposes the desired level of aggregate.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Densifying',
          text: 'A penetrating concrete densifier is applied to harden the surface, increasing strength, durability, and resistance to dusting.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Polishing',
          text: 'Finer diamond tooling is used in multiple passes to achieve the selected sheen level, from a subtle matte finish to a high-gloss polish.',
        },
        {
          '@type': 'HowToStep',
          position: 5,
          name: 'Sealing & Protection',
          text: 'A final protective sealer is applied to enhance stain resistance and ensure long-lasting performance.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<Layout
  title="Polished Concrete Flooring Phoenix | Brooks Floor Covering"
  description="Polished concrete flooring in Phoenix. Matte to high-gloss finishes for homes, offices, and commercial spaces. Free estimates — call (623) 688-8422."
  jsonLd={jsonLd}
  ogImage="/images/hero-polished-concrete-mountain-view.jpg"
>
  <Navigation />

  <Hero
    title="Polished Concrete Flooring in Phoenix, AZ"
    subtitle="Modern, high-performance polished concrete floors for homes, offices, and commercial spaces across the Greater Phoenix Area."
    compact={true}
  />

  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services' },
      { label: 'Polished Concrete' },
    ]}
  />

  <main>
    <!-- Introduction -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center gap-12 max-w-6xl mx-auto">
          <div class="md:w-1/2">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Polished Concrete Solutions
            </p>
            <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
              Durable, Beautiful Polished Concrete Floors
            </h2>
            <p class="text-neutral-700 leading-relaxed text-lg mb-4">
              Polished concrete is a modern, high-performance flooring solution that blends
              durability with refined design. Once reserved mainly for industrial spaces, polished
              concrete has become a sought-after option for homes, retail spaces, offices, and
              commercial facilities thanks to its versatility, longevity, and striking visual
              appeal.
            </p>
            <p class="text-neutral-700 leading-relaxed text-lg">
              Brooks Floor Covering provides expert polished concrete services for residential and
              commercial clients across Phoenix, Glendale, Scottsdale, Mesa, Chandler, and the
              entire Valley. Every project starts with a{' '}
              <a
                href="/contact"
                class="text-brand-primary font-semibold hover:text-brand-primary-dark transition-colors"
                >free, no-obligation estimate</a
              >.
            </p>
          </div>
          <div class="md:w-1/2">
            <Image
              src="/images/hero-polished-concrete-mountain-view.jpg"
              alt="Polished concrete floor reflecting a staircase and mountain view through glass walls"
              class="rounded-lg shadow-lg w-full"
              width={960}
              height={640}
              inferSize
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Polished Concrete -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Advantages
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Why Choose Polished Concrete?
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold text-neutral-800 mb-3">Built to Last</h3>
              <p class="text-neutral-700 leading-relaxed">
                Polished concrete is exceptionally durable. It resists heavy foot traffic, impacts,
                and wear far better than many traditional floor coverings. When properly installed
                and maintained, it can last for decades without the need for replacement.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold text-neutral-800 mb-3">Low Maintenance</h3>
              <p class="text-neutral-700 leading-relaxed">
                Unlike carpet, tile, or timber, polished concrete requires minimal upkeep. There's
                no waxing, sealing, or frequent refinishing. Just routine cleaning to keep it
                looking sharp.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold text-neutral-800 mb-3">Cost-Effective Over Time</h3>
              <p class="text-neutral-700 leading-relaxed">
                Because the existing concrete slab is used as the finished surface, polished
                concrete eliminates the need for additional floor coverings. Its long lifespan and
                low maintenance costs make it a smart long-term investment.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold text-neutral-800 mb-3">
                Sustainable & Eco-Friendly
              </h3>
              <p class="text-neutral-700 leading-relaxed">
                Polished concrete is an environmentally responsible choice. It uses the existing
                slab, reduces material waste, and improves light reflectivity, helping to lower
                lighting and energy costs.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Functional Benefits -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Performance
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">Functional Benefits</h2>
          <ul class="space-y-3 text-neutral-700 text-lg">
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span
                >Slip-resistant surface suitable for residential and commercial environments</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Highly resistant to moisture, stains, and allergens</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span
                >Ideal for high-traffic areas such as showrooms, warehouses, retail spaces, and
                modern homes</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Compatible with underfloor heating systems</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Aesthetic Appeal & Design Flexibility -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Design Options
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
            Aesthetic Appeal & Design Flexibility
          </h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-6">
            Polished concrete offers a clean, contemporary look that can be tailored to suit
            virtually any style. From sleek and minimalist to bold and industrial, each floor is
            completely unique.
          </p>
          <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
            <h3 class="text-lg font-semibold text-neutral-800 mb-4">Design options include:</h3>
            <ul class="space-y-3 text-neutral-700">
              <li class="flex items-start gap-3">
                <span class="text-brand-accent font-bold mt-1">&#10003;</span>
                <span><strong>Levels of sheen:</strong> matte, satin, or high-gloss finishes</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-accent font-bold mt-1">&#10003;</span>
                <span><strong>Aggregate exposure:</strong> minimal to full stone exposure</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-accent font-bold mt-1">&#10003;</span>
                <span
                  ><strong>Coloring and staining</strong> for warm, natural tones or dramatic modern finishes</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-accent font-bold mt-1">&#10003;</span>
                <span
                  ><strong>Decorative saw cuts or patterns</strong> to mimic tiles or create custom designs</span
                >
              </li>
            </ul>
            <p class="text-neutral-600 mt-4 italic">
              No two polished concrete floors are ever the same. Natural variations in the concrete
              ensure a one-of-a-kind result.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Process -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              How We Work
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Our Polished Concrete Process
            </h2>
          </div>
          <div class="space-y-8">
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  1
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">Surface Preparation</h3>
                <p class="text-neutral-700 leading-relaxed">
                  The existing concrete slab is inspected and prepared. Any coatings, adhesives, or
                  imperfections are removed to create a clean, even base.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  2
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">Grinding</h3>
                <p class="text-neutral-700 leading-relaxed">
                  Industrial diamond grinders are used to progressively grind the surface. This step
                  smooths the concrete and exposes the desired level of aggregate.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  3
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">Densifying</h3>
                <p class="text-neutral-700 leading-relaxed">
                  A penetrating concrete densifier is applied to harden the surface, increasing
                  strength, durability, and resistance to dusting.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  4
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">Polishing</h3>
                <p class="text-neutral-700 leading-relaxed">
                  Finer diamond tooling is used in multiple passes to achieve the selected sheen
                  level, from a subtle matte finish to a high-gloss polish.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  5
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">Sealing & Protection</h3>
                <p class="text-neutral-700 leading-relaxed">
                  A final protective sealer is applied to enhance stain resistance and ensure
                  long-lasting performance.
                </p>
              </div>
            </div>
          </div>

          <!-- Project Photos -->
          <div class="mt-16">
            <h3 class="text-xl font-semibold text-neutral-800 mb-4 text-center">
              From Raw Slab to Finished Floor
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <figure>
                <Image
                  src="/images/polished-concrete-commercial-raw-slab-before-polishing.jpg"
                  alt="Raw concrete slab in a commercial space before grinding and polishing"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Raw slab before grinding and polishing
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-commercial-open-floor-satin-sheen.jpg"
                  alt="Polished concrete floor with a satin sheen in a commercial space"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  A finished floor from the same project, polished to a satin sheen
                </figcaption>
              </figure>
            </div>

            <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-4 text-center">
              On the Job, Step by Step
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <figure>
                <Image
                  src="/images/polished-concrete-multihead-grinder-diamond-pads.jpg"
                  alt="Multi-head concrete grinder with diamond pads on a commercial slab"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Grinding with diamond pads, dust controlled by vacuum
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-wet-densifier-reflecting-open-floor.jpg"
                  alt="Wet densified concrete slab reflecting a commercial building under construction"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Densifier on the slab, reflecting the building above
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-office-corridor-half-polished-strip.jpg"
                  alt="Office corridor with a ground and polished strip beside unfinished slab"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  A corridor part-way through, polished on one side and raw on the other
                </figcaption>
              </figure>
            </div>

            <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-4 text-center">
              High-Gloss Polish
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <figure>
                <Image
                  src="/images/polished-concrete-high-gloss-window-reflections.jpg"
                  alt="High-gloss polished concrete floor reflecting windows"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Windows reflected in a high-gloss polish
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-dark-polish-glass-door-reflections.jpg"
                  alt="Dark polished concrete floor reflecting an open glass door"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Deep, dark polish at a glass entry door
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-commercial-corridor-reflections.jpg"
                  alt="Polished concrete corridor with long reflections down the hallway"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Polished corridor with a continuous, even sheen
                </figcaption>
              </figure>
            </div>

            <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-4 text-center">
              Exposed Aggregate Finish
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <figure>
                <Image
                  src="/images/polished-concrete-exposed-aggregate-warehouse-aisle.jpg"
                  alt="Polished exposed-aggregate concrete floor running through a shelving aisle"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Exposed aggregate through a warehouse aisle
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-exposed-aggregate-close-up.jpg"
                  alt="Close-up of polished concrete with exposed stone aggregate"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Close-up of the polished aggregate
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-exposed-aggregate-office-hallway.jpg"
                  alt="Polished exposed-aggregate concrete floor in an office hallway"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Office hallway with exposed aggregate
                </figcaption>
              </figure>
            </div>

            <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-4 text-center">
              Warehouses and Homes
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <figure>
                <Image
                  src="/images/polished-concrete-warehouse-polished-floor-steel-columns.jpg"
                  alt="Large warehouse with a polished concrete floor between steel columns"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Warehouse floor polished wall to wall
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-warehouse-wet-slab-mirror-reflection.jpg"
                  alt="Wet polished warehouse slab mirroring the steel roof structure"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Wet slab mirroring the roof structure
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-home-great-room-sliding-glass-doors.jpg"
                  alt="Polished concrete great room floor with sliding glass doors to a patio"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  A home great room in polished concrete
                </figcaption>
              </figure>
            </div>

            <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-4 text-center">
              New Homes and Garages
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <figure>
                <Image
                  src="/images/polished-concrete-new-home-slab-before-grinding-framed-great-room.jpg"
                  alt="Raw slab in a framed new-home great room before grinding"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Before: raw slab, walls framed
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/polished-concrete-new-home-great-room-wet-slab-half-done.jpg"
                  alt="New-home great room slab half wet-polished and half still raw"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
