---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import { serviceAreaCitiesSchema } from '../../data/navigation';
import FAQ from '../../components/FAQ.astro';

const faqs = [
  {
    question: 'What is the difference between a mud pan and a pre-formed shower pan?',
    answer:
      'A mud pan is a custom-built mortar bed that is hand-sloped to the drain, allowing a perfect fit for any shower size and shape. Pre-formed pans are factory-made and limited to standard sizes. Mud pans offer superior drainage, greater design flexibility, and better long-term durability because they are built specifically for your space.',
  },
  {
    question: 'How do you prevent leaks in a custom tile shower?',
    answer:
      'We use a multi-layer waterproofing approach that includes a shower pan liner beneath the mortar bed, cement backer board on all walls, and a full waterproofing membrane applied over the backer board and all seams, corners, and penetrations. This creates a continuous moisture barrier that prevents leaks before tile is ever installed.',
  },
  {
    question: 'What type of tile is best for showers?',
    answer:
      'Porcelain tile is the most popular choice for showers because it is dense, moisture-resistant, and available in a wide range of styles. Natural stone such as marble and travertine offers a luxury aesthetic but requires sealing and more maintenance. Mosaic tiles are ideal for shower floors and accent features because their smaller size allows for proper slope and drainage.',
  },
  {
    question: 'How long does a custom tile shower installation take?',
    answer:
      'A complete custom tile shower installation typically takes five to ten business days depending on the complexity of the design, size of the shower, and custom features like benches, niches, and accent walls. This includes waterproofing, mortar work, tile installation, grouting, and sealing. We provide a detailed timeline during your free estimate.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Tile Showers',
      description:
        'Custom tile shower design and installation in Phoenix. Waterproof, beautifully crafted showers for your home.',
      provider: {
        '@type': 'HomeAndConstructionBusiness',
        '@id': 'https://brooksfloorcovering.com/#business',
      },
      areaServed: serviceAreaCitiesSchema,
      serviceType: 'Custom Tile Shower Installation',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brooksfloorcovering.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://brooksfloorcovering.com/services/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Custom Tile Showers',
          item: 'https://brooksfloorcovering.com/services/custom-tile-showers/',
        },
      ],
    },
    {
      '@type': 'HowTo',
      name: 'Custom Tile Shower Installation Process',
      description:
        'Our step-by-step custom tile shower installation process ensures your shower is waterproof, structurally sound, and built to last.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Planning & Design',
          text: 'We start by discussing your vision, layout, tile selection, and functional needs. Measurements are taken, drain placement is confirmed, and design details are finalized before installation begins.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Shower Pan Liner Installation',
          text: 'A high-quality shower pan liner is installed to protect the subfloor from moisture. This critical layer directs water safely to the drain and prevents leaks before tile is ever laid.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Mud Shower Pan (Mortar Bed)',
          text: 'We hand-build a sloped mud shower pan to ensure proper drainage. Unlike pre-formed pans, a custom mud pan allows perfect slope to the drain, a precise fit for your space, and long-term stability and durability.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Backer Board Installation',
          text: 'Cement backer board is installed on all shower walls and ceilings as needed. This provides a solid, moisture-resistant surface designed specifically for tile installations.',
        },
        {
          '@type': 'HowToStep',
          position: 5,
          name: 'Waterproofing System',
          text: 'A full waterproofing membrane is applied over the backer board and critical seams, corners, and penetrations. This creates a continuous moisture barrier, one of the most important steps in a long-lasting shower.',
        },
        {
          '@type': 'HowToStep',
          position: 6,
          name: 'Custom Seats, Benches & Shelves',
          text: 'We build shower benches or seats for comfort and accessibility, recessed niches and shelves for storage, and custom shapes and sizes to match your design. All features are properly framed, sloped, and waterproofed.',
        },
        {
          '@type': 'HowToStep',
          position: 7,
          name: 'Tile Installation & Finishing',
          text: 'Your selected tile is carefully installed with precision spacing, clean cuts, and attention to detail. Once set, grout is applied and sealed for durability and a clean, finished look.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<Layout
  title="Custom Tile Showers Phoenix | Brooks Floor Covering"
  description="Custom tile shower design and installation in Phoenix. Waterproof, beautifully crafted showers for your home. Free estimates — call (623) 688-8422."
  jsonLd={jsonLd}
  ogImage="/images/tile-walk-in-shower-niche-accent.jpg"
>
  <Navigation />

  <Hero
    title="Custom Tile Showers in Phoenix, AZ"
    subtitle="Built for beauty. Built to last. Built just for you. Custom tile shower design and installation across the Greater Phoenix Area."
    compact={true}
  />

  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services' },
      { label: 'Custom Tile Showers' },
    ]}
  />

  <main>
    <!-- Introduction -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Custom Shower Solutions
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
            A Shower Designed Just for You
          </h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-4">
            A custom tile shower is more than a place to rinse off. It's a statement piece, a daily
            luxury, and a long-term investment in your home. At Brooks Floor Covering, we design and
            install fully customized tile showers that blend functionality, durability, and standout
            aesthetics.
          </p>
          <p class="text-neutral-700 leading-relaxed text-lg">
            From sleek modern designs to timeless stone looks, every shower we build is tailored to
            your space, your style, and your lifestyle. Contact us for a{' '}
            <a
              href="/contact"
              class="text-brand-primary font-semibold hover:text-brand-primary-dark transition-colors"
              >free, no-obligation estimate</a
            >.
          </p>
        </div>
      </div>
    </section>

    <!-- Why Choose a Custom Tile Shower -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Advantages
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Why Choose a Custom Tile Shower?
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold text-neutral-800 mb-3">
                Endless Design Possibilities
              </h3>
              <p class="text-neutral-700 leading-relaxed mb-4">
                Custom tile showers allow complete creative freedom. Choose from:
              </p>
              <ul class="space-y-2 text-neutral-700">
                <li class="flex items-start gap-2">
                  <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                  <span>Ceramic, porcelain, glass, or natural stone tile</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                  <span>Unique layouts, patterns, and accent walls</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                  <span>Custom niches, benches, and shelves</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                  <span>Matte, polished, textured, or mixed finishes</span>
                </li>
              </ul>
              <p class="text-neutral-600 mt-4 italic">
                No two showers are ever the same. Yours is truly one of a kind.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold text-neutral-800 mb-3">
                Superior Durability & Longevity
              </h3>
              <p class="text-neutral-700 leading-relaxed">
                When properly built, a custom tile shower is one of the most durable bathroom
                upgrades you can make. We focus on what's behind the tile just as much as what you
                see, ensuring long-term performance and moisture protection.
              </p>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold text-neutral-800 mb-3">Improved Functionality</h3>
              <p class="text-neutral-700 leading-relaxed mb-4">
                Custom showers aren't just beautiful. They're practical:
              </p>
              <ul class="space-y-2 text-neutral-700">
                <li class="flex items-start gap-2">
                  <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                  <span>Sloped pans for proper drainage</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                  <span>Built-in seating for comfort and accessibility</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                  <span>Recessed shelves to eliminate clutter</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                  <span>Layouts designed for easy maintenance and daily use</span>
                </li>
              </ul>
            </div>
            <div class="bg-white rounded-lg p-6 shadow-sm border border-neutral-200">
              <h3 class="text-lg font-semibold text-neutral-800 mb-3">Adds Value to Your Home</h3>
              <p class="text-neutral-700 leading-relaxed">
                A professionally installed tile shower adds both visual appeal and resale value.
                Buyers notice quality craftsmanship, and custom tile work makes a strong impression.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Installation Process -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              How We Work
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Our Custom Tile Shower Installation Process
            </h2>
            <p class="text-neutral-700 leading-relaxed text-lg mt-4">
              We believe great tile work starts with proper preparation. Our step-by-step process
              ensures your shower is waterproof, structurally sound, and built to last.
            </p>
          </div>
          <div class="space-y-8">
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  1
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">Planning & Design</h3>
                <p class="text-neutral-700 leading-relaxed">
                  We start by discussing your vision, layout, tile selection, and functional needs.
                  Measurements are taken, drain placement is confirmed, and design details are
                  finalized before installation begins.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  2
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">
                  Shower Pan Liner Installation
                </h3>
                <p class="text-neutral-700 leading-relaxed">
                  A high-quality shower pan liner is installed to protect the subfloor from
                  moisture. This critical layer directs water safely to the drain and prevents leaks
                  before tile is ever laid.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  3
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">
                  Mud Shower Pan (Mortar Bed)
                </h3>
                <p class="text-neutral-700 leading-relaxed mb-3">
                  We hand-build a sloped mud shower pan to ensure proper drainage. Unlike pre-formed
                  pans, a custom mud pan allows:
                </p>
                <ul class="space-y-2 text-neutral-700">
                  <li class="flex items-start gap-2">
                    <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                    <span>Perfect slope to the drain</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                    <span>A precise fit for your space</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                    <span>Long-term stability and durability</span>
                  </li>
                </ul>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  4
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">
                  Backer Board Installation
                </h3>
                <p class="text-neutral-700 leading-relaxed">
                  Cement backer board is installed on all shower walls and ceilings as needed. This
                  provides a solid, moisture-resistant surface designed specifically for tile
                  installations.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  5
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">Waterproofing System</h3>
                <p class="text-neutral-700 leading-relaxed">
                  A full waterproofing membrane is applied over the backer board and critical seams,
                  corners, and penetrations. This creates a continuous moisture barrier, one of the
                  most important steps in a long-lasting shower.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  6
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">
                  Custom Seats, Benches & Shelves
                </h3>
                <p class="text-neutral-700 leading-relaxed mb-3">We build:</p>
                <ul class="space-y-2 text-neutral-700">
                  <li class="flex items-start gap-2">
                    <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                    <span>Shower benches or seats for comfort and accessibility</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                    <span>Recessed niches and shelves for storage</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-brand-accent font-bold mt-0.5">&#10003;</span>
                    <span>Custom shapes and sizes to match your design</span>
                  </li>
                </ul>
                <p class="text-neutral-700 leading-relaxed mt-3">
                  All features are properly framed, sloped, and waterproofed to prevent water
                  intrusion.
                </p>
              </div>
            </div>
            <div class="flex gap-6">
              <div class="flex-shrink-0">
                <div
                  class="w-10 h-10 bg-brand-primary text-white rounded-full flex items-center justify-center font-bold text-lg"
                >
                  7
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-800 mb-2">
                  Tile Installation & Finishing
                </h3>
                <p class="text-neutral-700 leading-relaxed">
                  Your selected tile is carefully installed with precision spacing, clean cuts, and
                  attention to detail. Once set, grout is applied and sealed for durability and a
                  clean, finished look.
                </p>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-12">
            <figure>
              <Image
                src="/images/tile-shower-build-backer-board-window-niche.jpg"
                alt="Shower walls covered in backer board with a window and a recessed niche framed in"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Backer board on the shower walls, with the niche framed in
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-shower-build-sloped-bed-liner-block-curb.jpg"
                alt="Sloped mortar shower floor with a liner and a block curb"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Sloped mortar bed with the liner and curb in place
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-shower-build-sloped-bed-liner-closeup.jpg"
                alt="Close-up of a sloped mortar shower floor around the drain with the liner folded up the wall"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Close-up of the sloped floor and liner around the drain
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-shower-build-waterproofing-membrane-pan-niche.jpg"
                alt="Shower floor and wall bases coated in green waterproofing membrane with a bench"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Waterproofing membrane across the shower floor, curb and wall bases
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-shower-build-waterproofing-membrane-pan-finished.jpg"
                alt="Finished green waterproofing membrane across a shower floor"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Continuous membrane coat before tile goes on
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-shower-build-waterproofing-membrane-drain-closeup.jpg"
                alt="Waterproofing membrane applied around a shower drain"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Membrane applied around the drain
              </figcaption>
            </figure>
          </div>
        </div>

        <div class="max-w-4xl mx-auto mt-12">
          <h3 class="text-2xl font-bold mb-2 text-brand-dark">The Finished Result</h3>
          <p class="text-neutral-600 mb-6">
            Large-format tile, clean edge trim and details like niches and benches, built to last.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <figure>
              <Image
                src="/images/tile-shower-marble-look-large-format-hex-floor-bench.jpg"
                alt="Finished marble-look shower with hex mosaic floor and bench"
                class="rounded-lg shadow-md w-full aspect-[3/4] object-cover"
                width={600}
                height={800}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Finished marble-look shower with hex mosaic floor and bench
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-shower-white-marble-look-black-edge-trim.jpg"
                alt="White marble-look shower with black edge trim"
                class="rounded-lg shadow-md w-full aspect-[3/4] object-cover"
                width={600}
                height={800}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                White marble-look shower with black edge trim
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-shower-marble-look-mosaic-floor-niche-bench.jpg"
                alt="Mosaic floor, recessed niche and built-in bench"
                class="rounded-lg shadow-md w-full aspect-[3/4] object-cover"
                width={600}
                height={800}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Mosaic floor, recessed niche and built-in bench
              </figcaption>
            </figure>
          </div>
        </div>

        <div class="max-w-4xl mx-auto mt-16">
          <h3 class="text-2xl font-bold mb-2 text-brand-dark">Another Shower, Start to Finish</h3>
          <p class="text-neutral-600 mb-6">
            Waterproof pan, membrane, sloped mortar bed, then tile, with a bench and a glass accent
            band.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <figure>
              <Image
                src="/images/tile-slate-look-shower-waterproof-pan-blue-foam.jpg"
                alt="Shower pan lined with blue foam board and a curb drain before tiling"
                class="rounded-lg shadow-md w-full aspect-[4/5] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Waterproof pan and drain
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-slate-look-shower-red-membrane-walls.jpg"
                alt="Shower walls coated in red waterproofing membrane above the pan"
                class="rounded-lg shadow-md w-full aspect-[4/5] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Red membrane on the walls
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-slate-look-shower-mortar-bed-drain.jpg"
                alt="Sloped mortar bed around the drain inside a red-coated shower"
                class="rounded-lg shadow-md w-full aspect-[4/5] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Sloped mortar bed to the drain
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/tile-slate-look-shower-bench-tiled.jpg"
                alt="Built-in shower bench being tiled with large dark tile"
                class="rounded-lg shadow-md w-full aspect-[4/5] object-cover"
                width={1600}
                height={1200}
                inferSize
                loading="lazy"
              />
