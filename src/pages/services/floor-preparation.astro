---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import { serviceAreaCitiesSchema } from '../../data/navigation';
import FAQ from '../../components/FAQ.astro';

const faqs = [
  {
    question: 'Why is floor preparation important before installing new flooring?',
    answer:
      'Proper floor preparation is the foundation of any successful flooring installation. An unprepared or poorly prepared subfloor can lead to adhesion failure, uneven surfaces, cracking, and premature wear of the finished floor. Preparation addresses issues like moisture, levelness, surface profile, and contaminants that directly affect long-term performance.',
  },
  {
    question: 'What does moisture testing involve and why is it necessary?',
    answer:
      'Moisture testing measures the amount of water vapor being emitted from a concrete slab. Excess moisture is one of the leading causes of flooring failure. We use professional testing methods to evaluate moisture levels and determine whether mitigation systems are needed before installation. This step is required by most flooring manufacturers to maintain warranty coverage.',
  },
  {
    question: 'What is concrete surface profiling?',
    answer:
      'Concrete surface profiling is the process of mechanically preparing a concrete surface to achieve the correct texture for adhesion. Different flooring systems require different surface profiles, measured on the CSP scale. Grinding creates the appropriate profile to ensure coatings, adhesives, and overlay systems bond properly to the concrete.',
  },
  {
    question: 'When is self-leveling underlayment needed?',
    answer:
      'Self-leveling underlayment is needed when the existing floor is out of tolerance for the planned flooring system. Uneven, wavy, or sloped subfloors can cause visible imperfections in finished flooring such as vinyl plank, tile, or hardwood. Self-leveling compounds create a smooth, flat surface that meets manufacturer specifications for proper installation.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Floor Preparation Services',
      description:
        'Professional floor preparation in Phoenix. Concrete grinding, moisture mitigation, leveling, and subfloor prep for lasting flooring installations.',
      provider: {
        '@type': 'HomeAndConstructionBusiness',
        '@id': 'https://brooksfloorcovering.com/#business',
      },
      areaServed: serviceAreaCitiesSchema,
      serviceType: 'Floor Preparation',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brooksfloorcovering.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://brooksfloorcovering.com/services/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Floor Preparation',
          item: 'https://brooksfloorcovering.com/services/floor-preparation/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<Layout
  title="Floor Preparation Services Phoenix | Brooks Floor Covering"
  description="Floor preparation in Phoenix: concrete grinding, moisture mitigation, leveling, and subfloor prep. Free estimates — call (623) 688-8422."
  jsonLd={jsonLd}
  ogImage="/images/concrete-overlay-self-leveling-construction.jpg"
>
  <Navigation />

  <Hero
    title="Floor Preparation Services in Phoenix, AZ"
    subtitle="Professional concrete grinding, leveling, moisture mitigation, and subfloor preparation for lasting flooring installations across the Greater Phoenix Area."
    compact={true}
  />

  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services' },
      { label: 'Floor Preparation' },
    ]}
  />

  <main>
    <!-- Introduction -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Foundation for Success
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
            Great Floors Start with Proper Preparation
          </h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-4">
            At Brooks Floor Covering, we provide professional floor preparation services designed to
            create a smooth, level, and durable foundation for any flooring system. Whether the
            project involves tile, hardwood, vinyl, epoxy, or resilient and specialty flooring
            systems, our team uses advanced equipment and proven methods to ensure the subfloor is
            properly prepared for long-term performance.
          </p>
          <p class="text-neutral-700 leading-relaxed text-lg">
            We serve residential and commercial clients across Phoenix, Glendale, Scottsdale, Mesa,
            Chandler, and the entire Valley. Every project starts with a{' '}
            <a
              href="/contact"
              class="text-brand-primary font-semibold hover:text-brand-primary-dark transition-colors"
              >free, no-obligation estimate</a
            >.
          </p>
        </div>
      </div>
    </section>

    <!-- Concrete Grinding -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Surface Correction
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">Concrete Grinding</h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-6">
            Concrete grinding is essential for correcting imperfections and preparing surfaces for
            new flooring. Our concrete grinding services include:
          </p>
          <ul class="space-y-3 text-neutral-700 text-lg">
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Removing high spots and uneven areas</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Flattening and smoothing concrete slabs</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Eliminating trip hazards and surface irregularities</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Preparing concrete for coatings or floor coverings</span>
            </li>
          </ul>
          <p class="text-neutral-700 leading-relaxed text-lg mt-6">
            Our grinding process delivers improved floor flatness, ready for the next phase of
            installation.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-10">
            <figure>
              <Image
                src="/images/concrete-floor-grinder-three-head-slab-prep-wide.jpg"
                alt="Floor grinder with diamond tooling on a new-construction slab"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Floor grinder with diamond tooling on a new-construction slab
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/concrete-slab-ground-flat-ready-for-flooring-great-room.jpg"
                alt="Great-room slab ground and ready for flooring"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Great-room slab ground and ready for flooring
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/concrete-edge-grinder-bedroom-slab-prep.jpg"
                alt="Smaller grinder and dust control for bedrooms and tight spaces"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Smaller grinder and dust control for bedrooms and tight spaces
              </figcaption>
            </figure>
            <figure>
              <Image
                src="/images/concrete-slab-prepped-glass-walls-new-home.jpg"
                alt="Prepared slab ready for the next phase"
                class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                width={800}
                height={600}
                inferSize
                loading="lazy"
              />
              <figcaption class="text-sm text-neutral-600 mt-2">
                Prepared slab ready for the next phase
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Concrete Surface Profiling -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Adhesion Preparation
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
            Concrete Surface Profiling
          </h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-6">
            Proper concrete surface profiling is critical to achieving strong adhesion and
            long-lasting results. We provide mechanical surface preparation services such as:
          </p>
          <ul class="space-y-3 text-neutral-700 text-lg">
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Grinding concrete to achieve the required Concrete Surface Profile (CSP)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Surface preparation for epoxy, urethane, resinous, and flooring systems</span>
            </li>
          </ul>
          <p class="text-neutral-700 leading-relaxed text-lg mt-6">
            Our surface preparation methods meet manufacturer and project specifications.
          </p>
        </div>
      </div>
    </section>

    <!-- Adhesive & Coating Removal -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Clean Substrate
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
            Adhesive & Coating Removal
          </h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-6">
            Residual adhesives and existing coatings from previous flooring systems can interfere
            with new installations and compromise performance. We remove a wide range of materials,
            including:
          </p>
          <ul class="space-y-3 text-neutral-700 text-lg">
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Carpet glue</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Vinyl and VCT adhesives</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Cutback adhesives</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Pressure-sensitive residues</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Existing coatings, sealers, and paints</span>
            </li>
          </ul>
          <p class="text-neutral-700 leading-relaxed text-lg mt-6">
            The result is a clean, properly prepared surface ready for new flooring materials.
          </p>
        </div>
      </div>
    </section>

    <!-- Moisture Mitigation Systems -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Moisture Control
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
            Moisture Mitigation Systems
          </h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-6">
            Excess moisture is one of the most common causes of flooring failure. Our moisture
            mitigation services include:
          </p>
          <ul class="space-y-3 text-neutral-700 text-lg">
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Moisture testing and evaluation</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Installation of moisture mitigation systems</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Control of vapor emissions and hydrostatic pressure</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Compliance with flooring manufacturer moisture requirements</span>
            </li>
          </ul>
          <p class="text-neutral-700 leading-relaxed text-lg mt-6">
            These systems reduce the risk of moisture-related flooring failures.
          </p>
        </div>
      </div>
    </section>

    <!-- Waterproofing Systems -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Water Protection
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">Waterproofing Systems</h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-6">
            In areas exposed to moisture, proper waterproofing is essential. We install
            waterproofing systems for:
          </p>
          <ul class="space-y-3 text-neutral-700 text-lg">
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Bathrooms and wet areas</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Commercial kitchens</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Upper-level areas with occupied living, office, or retail space below</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Multi-family and commercial spaces</span>
            </li>
          </ul>
          <p class="text-neutral-700 leading-relaxed text-lg mt-6">
            These systems protect substrates from water intrusion and long-term damage.
          </p>

          <div class="mt-12">
            <h3 class="text-xl font-semibold text-neutral-800 mb-4 text-center">
              Drains and Large Floors
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <figure>
                <Image
                  src="/images/concrete-commercial-slab-prepped-before-waterproofing.jpg"
                  alt="Prepped concrete slab in a large commercial space before waterproofing"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Slab prepped and cleaned
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/concrete-floor-drain-membrane-cut-to-flange.jpg"
                  alt="Waterproofing membrane cut and fitted around a floor drain flange"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Membrane cut to fit the drain
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/concrete-floor-drain-green-membrane-sealed.jpg"
                  alt="Floor drain flange sealed with a green waterproofing membrane"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Drain flange sealed in membrane
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/concrete-commercial-slab-wet-topping-reflections.jpg"
                  alt="Large commercial slab with a freshly placed topping layer reflecting overhead lights"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Topping placed across the floor
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/concrete-commercial-drains-leveled-wall-base.jpg"
                  alt="Leveled floor with floor drains and a sealed wall base"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Drains and wall base, leveled and sealed
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Self-Leveling Underlayment -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Level Surfaces
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
            Self-Leveling Underlayment
          </h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-6">
            When floors are out of tolerance, self-leveling underlayment creates a smooth, flat
            surface suitable for modern flooring installations. Self-leveling underlayment is ideal
            for:
          </p>
          <ul class="space-y-3 text-neutral-700 text-lg">
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Correcting uneven or wavy slabs</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Preparing floors for vinyl plank, tile, or wood</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Residential and commercial applications</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-accent font-bold mt-1">&#10003;</span>
              <span>Meeting flatness requirements for modern flooring systems</span>
            </li>
          </ul>

          <div class="mt-12">
            <h3 class="text-xl font-semibold text-neutral-800 mb-4 text-center">
              Before and After the Pour
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <figure>
                <Image
                  src="/images/concrete-self-leveler-framed-home-slab-before-pour.jpg"
                  alt="Patched and prepped concrete slab in a framed home before self-leveler is poured"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Prepped slab, ready for the pour
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/concrete-self-leveler-framed-home-freshly-poured.jpg"
                  alt="Same framed home after the self-leveling underlayment has been poured"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Freshly poured and self-leveling
                </figcaption>
              </figure>
            </div>

            <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-4 text-center">
              On the Job
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <figure>
                <Image
                  src="/images/concrete-self-leveler-pump-mixer-on-site.jpg"
                  alt="Self-leveler pump and mixer set up outside a job site"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Pump and mixer on site
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/concrete-self-leveler-pour-stream-round-room.jpg"
                  alt="Self-leveling underlayment flowing from a hose across a round room"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Underlayment flowing from the hose
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/concrete-self-leveler-hallway-hose-pour.jpg"
                  alt="Self-leveling underlayment being poured down a long hallway"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">Pouring a hallway</figcaption>
              </figure>
            </div>

            <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-4 text-center">
              A Flat, Smooth Surface
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <figure>
                <Image
                  src="/images/concrete-self-leveler-kitchen-smooth-wet-surface.jpg"
                  alt="Smooth wet self-leveler across a kitchen floor"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Kitchen floor right after the pour
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/concrete-self-leveler-great-room-sliding-doors.jpg"
                  alt="Glossy self-leveling underlayment in a great room with sliding glass doors"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Great room right after the pour
                </figcaption>
              </figure>
              <figure>
                <Image
                  src="/images/concrete-self-leveler-window-wall-reflection-grid.jpg"
                  alt="Wet self-leveler reflecting a window wall in a commercial building"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Poured flat at a window wall
                </figcaption>
              </figure>
            </div>

            <h3 class="text-xl font-semibold text-neutral-800 mt-12 mb-2 text-center">
              Moisture System Capped with Self-Leveler
            </h3>
            <p class="text-neutral-600 mb-4 text-center">
              An office kitchenette: old adhesive ground off, an epoxy moisture system applied, then
              capped with self-leveler for a vinyl plank installation.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <figure>
                <Image
                  src="/images/concrete-office-kitchenette-grinder-removing-old-adhesive.jpg"
                  alt="Floor grinder working over old adhesive on an office kitchenette floor"
                  class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                  width={1600}
                  height={1200}
                  inferSize
                  loading="lazy"
                />
                <figcaption class="text-sm text-neutral-600 mt-2">
                  Grinding off the old adhesive
                </figcaption>
              </figure>
              <figure>
                <Image
