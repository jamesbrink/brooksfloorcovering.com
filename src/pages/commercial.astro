---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import { trustedOrgs } from '../data/clients';
import FloorIcon from '../components/FloorIcon.astro';

const commercialSolutions = [
  {
    icon: 'carpet',
    title: 'Carpet Tile',
    description:
      'Modular carpet tile for offices, conference rooms, and retail spaces. Easy to replace individual tiles for long-term maintenance savings.',
    link: '/services/carpet',
  },
  {
    icon: 'plank',
    title: 'Luxury Vinyl Plank & Tile',
    description:
      'Waterproof, scratch-resistant LVP and LVT for high-traffic commercial environments. Modern wood and stone looks with commercial-grade durability.',
    link: '/services/luxury-vinyl-plank',
  },
  {
    icon: 'vinyl-sheet',
    title: 'Sheet Vinyl',
    description:
      'Seamless sheet vinyl for healthcare facilities, kitchens, and high-moisture commercial settings. Easy to clean and maintain.',
    link: '/services',
  },
  {
    icon: 'tile',
    title: 'Tile & Stone',
    description:
      'Porcelain, ceramic, and natural stone tile for lobbies, restaurants, restrooms, and heavy-use commercial areas built to last.',
    link: '/services/tile',
  },
  {
    icon: 'polished',
    title: 'Polished Concrete',
    description:
      'High-gloss polished concrete for warehouses, showrooms, restaurants, and retail spaces. Low maintenance with a professional finish.',
    link: '/services/polished-concrete',
  },
  {
    icon: 'epoxy',
    title: 'Epoxy Coatings',
    description:
      'Industrial-strength epoxy for warehouses, hangars, garages, and manufacturing facilities. Chemical-resistant and extremely durable.',
    link: '/services/epoxy',
  },
];

const galleryPreview = [
  {
    src: '/images/polished-concrete-terrazzo-paver-atrium-refinished-wide.jpg',
    title: 'Terrazzo Paver Refinish',
    description:
      'Terrazzo pavers on a raised floor system, ground and refinished in a large commercial atrium',
  },
  {
    src: '/images/polished-concrete-aircraft-hangar.jpg',
    title: 'Aircraft Hangar Floor',
    description: 'King Air 360 sitting on a pristine polished hangar floor',
  },
  {
    src: '/images/concrete-self-leveler-building-window-wall-glossy-pour.jpg',
    title: 'Self-Leveling Underlayment',
    description: 'Glossy self-leveling pour reflecting a glass wall in a large new building',
  },
  {
    src: '/images/tile-commercial-retail-space-large-format-tile-wide.jpg',
    title: 'Large-Format Tile, Retail Space',
    description: 'Large-format tile set across a commercial retail space',
  },
  {
    src: '/images/polished-concrete-warehouse-after.jpg',
    title: 'Warehouse After Polishing',
    description: 'Same warehouse with mirror-finish polished concrete — night and day difference',
  },
  {
    src: '/images/epoxy-metallic-retail-storefront.jpg',
    title: 'Metallic Epoxy Floor',
    description: 'Dark metallic epoxy with swirl pattern in a retail storefront',
  },
];

const featuredProjects = [
  {
    title: 'Terrazzo Paver Refinishing, Large Atrium',
    description:
      'Terrazzo pavers on a raised floor system, ground and refinished across a large commercial atrium and its corridors.',
    photos: [
      {
        src: '/images/polished-concrete-terrazzo-paver-atrium-refinished-wide.jpg',
        alt: 'Refinished terrazzo paver floor in a large commercial atrium',
        caption: 'Finished atrium floor',
      },
      {
        src: '/images/polished-concrete-terrazzo-paver-atrium-grinding-pass-wood-columns.jpg',
        alt: 'Floor grinder making a pass across terrazzo pavers beside wood columns',
        caption: 'Grinding pass across the pavers',
      },
      {
        src: '/images/polished-concrete-terrazzo-paver-atrium-aggregate-closeup.jpg',
        alt: 'Close-up of terrazzo paver aggregate and joints after refinishing',
        caption: 'Paver detail after refinishing',
      },
      {
        src: '/images/polished-concrete-terrazzo-paver-atrium-corridor-refinished.jpg',
        alt: 'Long corridor of refinished terrazzo pavers',
        caption: 'Refinished corridor',
      },
    ],
  },
  {
    title: 'Office Building, Scottsdale',
    description:
      'Tile in most of the suites and carpet in the suites and corridors, with the corridor and suite carpet shown here.',
    photos: [
      {
        src: '/images/carpet-office-building-scottsdale-stair-landing-corridor.jpg',
        alt: 'Patterned carpet at a stair landing in a Scottsdale office building',
        caption: 'Carpet at the stair landing',
      },
      {
        src: '/images/carpet-office-building-scottsdale-corridor-wood-trim.jpg',
        alt: 'Carpeted office building corridor with wood trim',
        caption: 'Corridor carpet',
      },
      {
        src: '/images/carpet-office-building-scottsdale-suite-hallway-glass-doors.jpg',
        alt: 'Carpeted suite hallway with glass doors',
        caption: 'Suite hallway',
      },
      {
        src: '/images/carpet-office-building-scottsdale-finished-suite.jpg',
        alt: 'Finished office suite with new carpet',
        caption: 'Finished suite',
      },
    ],
  },
  {
    title: 'Self-Leveling Underlayment, Large New Building',
    description:
      'Self-leveling underlayment installed throughout a large new building, from the bare slab to a flat, smooth floor ready for finish flooring.',
    photos: [
      {
        src: '/images/concrete-self-leveler-building-bare-slab-before-pour.jpg',
        alt: 'Bare concrete slab with sunlight before the self-leveling pour',
        caption: 'Bare slab before the pour',
      },
      {
        src: '/images/concrete-self-leveler-building-crew-mixing-pumps.jpg',
        alt: 'Crew mixing and pumping self-leveling underlayment beside pallets of material',
        caption: 'Mixing and pumping on site',
      },
      {
        src: '/images/concrete-self-leveler-building-glass-wall-flat-floor.jpg',
        alt: 'Flat self-leveled floor beside a glass wall',
        caption: 'Flat floor at the glass wall',
      },
      {
        src: '/images/concrete-self-leveler-building-window-wall-glossy-pour.jpg',
        alt: 'Glossy self-leveling pour reflecting a window wall',
        caption: 'Finished pour reflecting the windows',
      },
    ],
  },
];

const commercialJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Commercial Flooring Services',
      description:
        'Commercial flooring installation services in Phoenix including carpet tile, LVP, sheet vinyl, tile, polished concrete, and epoxy coatings for offices, retail, restaurants, and industrial spaces.',
      provider: {
        '@type': 'HomeAndConstructionBusiness',
        '@id': 'https://brooksfloorcovering.com/#business',
      },
      areaServed: {
        '@type': 'State',
        name: 'Arizona',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brooksfloorcovering.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Commercial Flooring',
          item: 'https://brooksfloorcovering.com/commercial/',
        },
      ],
    },
  ],
};
---

<Layout
  title="Commercial Flooring Phoenix | Brooks Floor Covering"
  description="Commercial flooring in Phoenix: carpet tile, LVP, epoxy, and polished concrete for offices, retail, and industrial spaces. Free estimates, (623) 688-8422."
  jsonLd={commercialJsonLd}
  ogImage="/images/polished-concrete-restaurant-kitchen.jpg"
>
  <Navigation />

  <Hero
    title="Commercial Flooring Services"
    subtitle="Dependable flooring solutions for businesses, property managers, and contractors across the Greater Phoenix Area."
    compact={true}
  />

  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Commercial Flooring' }]} />

  <main>
    <!-- Introduction -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Commercial Flooring Experts
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
            Flooring Built for Business
          </h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-4">
            Flooring in a commercial environment must support daily operations, withstand constant
            traffic, and maintain a professional appearance. At Brooks Floor Covering, our
            commercial services are structured to provide businesses, property managers, and
            contractors with dependable guidance, quality materials, and efficient installation
            backed by more than
            <strong>30 years of local experience</strong>.
          </p>
          <p class="text-neutral-700 leading-relaxed text-lg mb-4">
            We approach every commercial project with organization, responsiveness, and a focus on
            long-term performance, helping keep your project on schedule and your space ready for
            use. From on-site evaluations and accurate planning to coordinated execution with
            multiple stakeholders, we prioritize straightforward communication and proactive
            updates.
          </p>
          <p class="text-neutral-700 leading-relaxed text-lg">
            Whether you are renovating an existing space, building new, or planning a multi-phase
            project, our team is prepared to support your goals with experience and professionalism.
            Every commercial project starts with a{' '}
            <a
              href="/contact"
              class="text-brand-primary font-semibold hover:text-brand-primary-dark transition-colors"
              >free, no-obligation estimate</a
            >.
          </p>
        </div>
      </div>
    </section>

    <!-- Commercial Solutions Grid -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            What We Offer
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
            Commercial Flooring Solutions
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
          {
            commercialSolutions.map((solution) => (
              <div class="bg-white rounded-xl p-8 shadow-sm border border-neutral-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                <div
                  class="w-14 h-14 bg-blue-50 text-brand-primary rounded-xl flex items-center justify-center mb-4"
                  aria-hidden="true"
                >
                  <FloorIcon name={solution.icon} />
                </div>
                <h3 class="text-xl font-semibold mb-3 text-neutral-800">{solution.title}</h3>
                <p class="text-neutral-600 leading-relaxed mb-4">{solution.description}</p>
                <a
                  href={solution.link}
                  class="text-brand-primary font-semibold hover:text-brand-primary-dark transition-colors text-sm"
                >
                  Learn More &rarr;
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Approach -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            How We Work
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">Our Commercial Approach</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-6xl mx-auto">
          <div class="bg-white rounded-lg border border-neutral-200 p-6">
            <h3 class="text-lg font-semibold text-neutral-800 mb-2">
              Experience That Supports Project Success
            </h3>
            <p class="text-neutral-600 leading-relaxed">
              With decades in the flooring industry, our team understands the demands placed on
              commercial surfaces. We help clients select materials that align with traffic levels,
              maintenance expectations, safety considerations, and overall design goals.
            </p>
          </div>
          <div class="bg-white rounded-lg border border-neutral-200 p-6">
            <h3 class="text-lg font-semibold text-neutral-800 mb-2">
              Local Partnership with Proven Reliability
            </h3>
            <p class="text-neutral-600 leading-relaxed">
              As a locally owned company, we value strong professional relationships within the
              community. Our clients rely on us for consistent service, accountability, and results
              that meet the standards of commercial environments.
            </p>
          </div>
          <div class="bg-white rounded-lg border border-neutral-200 p-6">
            <h3 class="text-lg font-semibold text-neutral-800 mb-2">
              On-Site Evaluations for Accurate Planning
            </h3>
            <p class="text-neutral-600 leading-relaxed">
              Every commercial space presents unique requirements. Our on-site evaluations allow us
              to assess conditions, take precise measurements, and recommend flooring solutions that
              support both function and appearance.
            </p>
          </div>
          <div class="bg-white rounded-lg border border-neutral-200 p-6">
            <h3 class="text-lg font-semibold text-neutral-800 mb-2">
              Clear Communication and Coordinated Execution
            </h3>
            <p class="text-neutral-600 leading-relaxed">
              Commercial projects often involve multiple stakeholders and firm timelines. We
              prioritize straightforward communication, coordinated scheduling, and proactive
              updates to help projects move forward efficiently.
            </p>
          </div>
        </div>
        <div class="max-w-4xl mx-auto mt-12">
          <h3 class="text-2xl font-bold text-brand-dark mb-4 font-display">
            Installation Focused on Efficiency
          </h3>
          <p class="text-neutral-700 leading-relaxed text-lg mb-4">
            Proper installation is essential in minimizing disruption to your operations. Our
            installation professionals emphasize preparation, safety, and precision while working to
            meet agreed-upon timelines.
          </p><p class="text-neutral-700 leading-relaxed text-lg mb-4">
            When possible, we coordinate installation schedules to accommodate business hours and
            reduce downtime, helping your organization maintain productivity.
          </p>
        </div>
        <div class="max-w-4xl mx-auto mt-12">
          <h3 class="text-2xl font-bold text-brand-dark mb-4 font-display">
            Built for Long-Term Performance
          </h3>
          <p class="text-neutral-700 leading-relaxed text-lg mb-4">
            Commercial clients return to Brooks Floor Covering because of our steady workmanship,
            organized process, and dependable results. We focus on flooring solutions that not only
            look professional on day one but continue to perform well over time.
          </p>
        </div>
      </div>
    </section>

    <!-- Trusted Organizations -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Our Clients
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-dark font-display tracking-tight">
            Trusted by Leading Organizations
          </h2>
        </div>

        <div class="flex flex-wrap justify-center items-center gap-x-14 gap-y-10 max-w-6xl mx-auto">
          {
            trustedOrgs.map((org) => (
              <div class="flex items-center justify-center p-4">
                <Image
                  src={org.logo}
                  alt={`${org.name} logo`}
                  class="w-32 h-auto max-h-16 object-contain hover:scale-110 hover:shadow-lg transition-all duration-300"
                  width={128}
                  height={64}
                  inferSize
                  loading="lazy"
                />
              </div>
            ))
          }
        </div>
        <p class="text-center text-neutral-500 text-sm mt-10 max-w-3xl mx-auto leading-relaxed">
          We have had the privilege of providing flooring services to the organizations listed
          above, both through direct partnerships and through our work as a trusted subcontractor
          alongside general contractors. This list reflects completed projects and professional
          relationships, not endorsements.
        </p>
      </div>
    </section>

    <!-- Featured Commercial Projects -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Featured Projects
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
            Large-Scale Commercial Work
          </h2>
        </div>
        <div class="max-w-6xl mx-auto space-y-16">
          {
            featuredProjects.map((project) => (
              <div>
                <h3 class="text-xl font-semibold text-neutral-800 mb-2">{project.title}</h3>
                <p class="text-neutral-600 leading-relaxed mb-6 max-w-3xl">{project.description}</p>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                  {project.photos.map((photo) => (
                    <figure>
                      <img
                        src={photo.src}
                        alt={photo.alt}
                        width="1600"
                        height="1200"
                        loading="lazy"
                        class="rounded-lg shadow-md w-full aspect-[4/3] object-cover"
                      />
                      <figcaption class="text-sm text-neutral-600 mt-2">{photo.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Commercial Project Gallery -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Our Work
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">Recent Commercial Projects</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {
            galleryPreview.map((image) => (
              <a
                href="/gallery"
                class="group block aspect-square overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-all duration-300 bg-neutral-100 relative"
              >
                <Image
                  src={image.src}
                  alt={`${image.title} — ${image.description}`}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                  width={400}
                  height={400}
                  inferSize
                  loading="lazy"
                />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-3 pt-8 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <p class="text-white text-sm font-semibold leading-tight">{image.title}</p>
                  <p class="text-white/80 text-xs mt-0.5 leading-snug">{image.description}</p>
                </div>
              </a>
            ))
          }
        </div>
        <div class="text-center mt-10">
          <a
            href="/gallery"
            class="inline-block text-brand-primary font-semibold hover:text-brand-primary-dark transition-colors text-lg"
          >
            View Full Gallery &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Why Choose Us for Commercial -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              The Brooks Advantage
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Why Businesses Trust Brooks
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="text-center">
              <h3 class="text-lg font-semibold mb-2 text-neutral-800">30+ Years Experience</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">
                Decades of commercial flooring expertise across offices, retail, restaurants,
                warehouses, and industrial facilities.
              </p>
            </div>
            <div class="text-center">
              <h3 class="text-lg font-semibold mb-2 text-neutral-800">Project Coordination</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">
                Clear communication, coordinated scheduling, and proactive updates to keep
                multi-stakeholder projects on track.
              </p>
            </div>
            <div class="text-center">
              <h3 class="text-lg font-semibold mb-2 text-neutral-800">Minimal Downtime</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">
                We coordinate installation schedules to accommodate business hours and reduce
                disruption to your operations.
              </p>
            </div>
            <div class="text-center">
              <h3 class="text-lg font-semibold mb-2 text-neutral-800">
                Licensed, Bonded & Insured
              </h3>
              <p class="text-neutral-600 text-sm leading-relaxed">
                Arizona <a
                  href="https://azroc.my.site.com/AZRoc/s/contractor-search"
                  target="_blank"
                  rel="noopener"
                  class="underline hover:text-brand-primary transition-colors">ROC #226840</a
                >. Fully licensed, bonded, and insured for your protection on every commercial
                project.
              </p>
            </div>
            <div class="text-center">
              <h3 class="text-lg font-semibold mb-2 text-neutral-800">Factory-Trained</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">
                Our installers are certified by Mohawk, Shaw, Arizona Tile, and Daltile for
                commercial-grade product handling.
              </p>
            </div>
            <div class="text-center">
              <h3 class="text-lg font-semibold mb-2 text-neutral-800">On-Site Evaluations</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">
                Accurate planning begins with on-site assessment of conditions, precise
                measurements, and tailored recommendations.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-br from-brand-dark to-brand-navy text-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 font-display tracking-tight">
          Start Your Commercial Flooring Project
        </h2>
        <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">
          Whether you are renovating, building new, or planning a multi-phase project, our team is
          ready to deliver professional results. Get started with a free commercial estimate today.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="inline-block bg-brand-accent text-white px-10 py-4 rounded-lg font-semibold hover:bg-brand-accent-dark transition duration-300 text-lg shadow-lg"
          >
            Get Your Free Estimate
          </a>
          <a
            href="tel:+16236888422"
            class="inline-block bg-white/10 text-white px-10 py-4 rounded-lg font-semibold hover:bg-white/20 transition duration-300 text-lg border border-white/30"
          >
            Call (623) 688-8422
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
