const servicesJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      itemListElement: allServices.map((service, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Service',
          name: service.name,
          url: service.url,
          provider: {
            '@type': 'HomeAndConstructionBusiness',
            '@id': 'https://brooksfloorcovering.com/#business',
          },
          areaServed: {
            '@type': 'State',
            name: 'Arizona',
          },
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://brooksfloorcovering.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://brooksfloorcovering.com/services/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title="Flooring Services in Phoenix, AZ | Brooks Floor Covering"
  description="Professional flooring installation, repair, concrete, and specialty tile services in Phoenix and across the Valley. Free estimates — call (623) 688-8422."
  jsonLd={servicesJsonLd}
  ogImage="/images/site-brooks-team-flooring-project.jpg"
>
  <Navigation />

  <Hero
    title="Our Services"
    subtitle="Comprehensive services directory for professional flooring, concrete, and specialty solutions for residential and commercial projects throughout the Greater Phoenix Area."
    compact={true}
  />

  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />

  <main>
    <!-- Introduction -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
            Full-Service Floor Covering
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-brand-dark">
            From Concrete Preparation to Specialty Finishes
          </h2>
          <p class="text-neutral-700 leading-relaxed text-lg mb-4">
            Brooks Floor Covering is a full-service floor covering company specializing in
            preparation, installation, restoration, and specialty surface solutions for residential,
            commercial, and industrial spaces. From concrete preparation and surface systems to fine
            finish details, our team delivers durable results, clean installations, and floors built
            to perform. With over 30 years of experience, we are licensed, bonded, and insured (<a
              href="https://azroc.my.site.com/AZRoc/s/contractor-search"
              target="_blank"
              rel="noopener"
              class="underline hover:text-brand-primary">ROC #226840</a
            >), and our installers are factory-trained by leading manufacturers including Mohawk,
            Shaw, Arizona Tile, and Daltile.
          </p>
          <p class="text-neutral-700 leading-relaxed text-lg">
            Whether you need a single repair or a complete flooring system, we deliver solutions
            built on precision, durability, and craftsmanship. Every project starts with a{' '}
            <a
              href="/contact"
              class="text-brand-primary font-semibold hover:text-brand-primary-dark transition-colors"
              >free, no-obligation estimate</a
            >.
          </p>
        </div>
      </div>
    </section>

    <!-- Flooring Installation Category -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Flooring Solutions
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Professional Flooring Installation
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
              flooringServices.map((service) => (
                <a
                  href={service.href}
                  class="group block overflow-hidden border border-neutral-200 rounded-lg bg-white border-t-4 border-t-brand-accent hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
                >
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="800"
                    height="450"
                    loading="lazy"
                    class="w-full h-48 object-cover"
                  />
                  <div class="p-6">
                    <div
                      class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center text-3xl mb-4"
                      aria-hidden="true"
                    >
                      {service.icon}
                    </div>
                    <h3 class="text-xl font-semibold mb-3 text-neutral-800">{service.title}</h3>
                    <p class="text-neutral-700 mb-4 leading-relaxed">{service.description}</p>
                    <span class="text-brand-primary font-semibold group-hover:text-brand-primary-dark transition-colors text-sm">
                      Learn More &rarr;
                    </span>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Concrete & Surface Systems Category -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Concrete Services
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">
              Concrete & Surface Systems
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
              concreteServices.map((service) => (
                <a
                  href={service.href}
                  class="group block overflow-hidden border border-neutral-200 rounded-lg bg-white border-t-4 border-t-brand-accent hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
                >
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="800"
                    height="450"
                    loading="lazy"
                    class="w-full h-48 object-cover"
                  />
                  <div class="p-6">
                    <div
                      class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center text-3xl mb-4"
                      aria-hidden="true"
                    >
                      {service.icon}
                    </div>
                    <h3 class="text-xl font-semibold mb-3 text-neutral-800">{service.title}</h3>
                    <p class="text-neutral-700 mb-4 leading-relaxed">{service.description}</p>
                    <span class="text-brand-primary font-semibold group-hover:text-brand-primary-dark transition-colors text-sm">
                      Learn More &rarr;
                    </span>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Specialty Services Category -->
    <section class="py-20 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Custom Work
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">Specialty & Custom Work</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
            <a
              href="/services/custom-tile-showers"
              class="group block overflow-hidden border border-neutral-200 rounded-lg bg-white border-t-4 border-t-brand-accent hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
            >
              <img
                src="/images/tile-custom-shower-natural-stone.jpg"
                alt="Custom tile shower finished with natural stone"
                width="800"
                height="450"
                loading="lazy"
                class="w-full h-48 object-cover"
              />
              <div class="p-6">
                <div
                  class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center text-3xl mb-4"
                  aria-hidden="true"
                >
                  🚿
                </div>
                <h3 class="text-xl font-semibold mb-3 text-neutral-800">Custom Tile Showers</h3>
                <p class="text-neutral-700 mb-4 leading-relaxed">
                  Complete custom shower systems including waterproofing, tile installation, and
                  custom layouts.
                </p>
                <span
                  class="text-brand-primary font-semibold group-hover:text-brand-primary-dark transition-colors text-sm"
                >
                  Learn More &rarr;
                </span>
              </div>
            </a>
          </div>
          <div class="bg-white rounded-lg border border-neutral-200 p-6">
            <h3 class="text-lg font-semibold text-neutral-800 mb-4">
              Additional Specialty Services
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
              {
                specialtyInlineServices.map((service) => (
                  <div>
                    <h4 class="font-semibold text-neutral-800 mb-1">{service.title}</h4>
                    <p class="text-neutral-600 text-sm leading-relaxed">{service.description}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Repairs & Restoration Category -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold mb-3">
              Restore & Maintain
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">Repairs & Restoration</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {
              repairServices.map((service) => (
                <div class="bg-neutral-50 rounded-lg border border-neutral-200 p-6">
                  <h3 class="text-lg font-semibold text-neutral-800 mb-2">{service.title}</h3>
                  <p class="text-neutral-600 leading-relaxed">{service.description}</p>
                  {service.href && (
                    <a
                      href={service.href}
