const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://brooksfloorcovering.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Gallery',
      item: 'https://brooksfloorcovering.com/gallery/',
    },
  ],
};

// Gallery filter categories, derived from the image filename prefix
const categoryDefs = [
  { id: 'tile', label: 'Tile & Showers' },
  { id: 'carpet', label: 'Carpet' },
  { id: 'hardwood', label: 'Hardwood' },
  { id: 'vinyl', label: 'Vinyl Plank' },
  { id: 'concrete', label: 'Concrete' },
  { id: 'epoxy', label: 'Epoxy' },
];

function getCategory(src: string): string {
  const file = src.split('/').pop() ?? '';
  if (file.startsWith('tile-')) return 'tile';
  if (file.startsWith('carpet-')) return 'carpet';
  if (file.startsWith('hardwood-')) return 'hardwood';
  if (file.startsWith('vinyl-')) return 'vinyl';
  if (file.startsWith('epoxy-')) return 'epoxy';
  if (file.includes('concrete-')) return 'concrete';
  return 'other';
}

const categoryCounts = new Map<string, number>();
for (const image of galleryImages) {
  const category = getCategory(image.src);
  categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
}
const filterButtons = categoryDefs.filter((c) => (categoryCounts.get(c.id) ?? 0) > 0);

const galleryJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Brooks Floor Covering Project Gallery',
  description:
    'Completed flooring projects throughout the Phoenix Valley — tile, carpet, polished concrete, epoxy, and concrete overlays.',
  itemListElement: galleryImages.map((image, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'ImageObject',
      contentUrl: `https://brooksfloorcovering.com${image.src}`,
      name: image.title,
      description: image.description,
      creditText: 'Brooks Floor Covering',
    },
  })),
};
---

<Layout
  title="Flooring Project Gallery | Phoenix, AZ - Tile, Carpet, Concrete"
  description="Browse our portfolio of completed flooring projects throughout the Phoenix Valley. Hardwood, tile, carpet, vinyl, concrete, and custom installations."
  jsonLd={[breadcrumbJsonLd, galleryJsonLd]}
  ogImage="/images/tile-master-bathroom-full-remodel.jpg"
>
  <Navigation />

  <Hero
    title="Our Project Gallery"
    subtitle="Browse through our extensive portfolio of completed flooring projects throughout the Phoenix Valley."
    compact={true}
  />

  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Gallery' }]} />

  <main>
    <!-- Intro Paragraph -->
    <section class="pt-12 pb-4 bg-neutral-50">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <p class="text-neutral-700 leading-relaxed text-lg">
          From custom tile showers and full bathroom remodels to wall-to-wall carpet installations,
          polished concrete, and metallic epoxy coatings, our portfolio showcases the range of
          flooring projects we've completed for homes and businesses across Phoenix, Scottsdale,
          Glendale, Mesa, and the Greater Phoenix Area.
        </p>
      </div>
    </section>

    <!-- Gallery Grid -->
    <section class="py-16 bg-neutral-50">
      <div class="container mx-auto px-4">
        <div
          class="flex flex-wrap justify-center gap-2 mb-10 max-w-7xl mx-auto"
          role="group"
          aria-label="Filter projects by flooring type"
          id="gallery-filters"
        >
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="filter-btn px-4 py-2 rounded-full border text-sm font-semibold transition duration-200"
          >
            All <span class="opacity-70">({galleryImages.length})</span>
          </button>
          {
            filterButtons.map((c) => (
              <button
                type="button"
                data-filter={c.id}
                aria-pressed="false"
                class="filter-btn px-4 py-2 rounded-full border text-sm font-semibold transition duration-200"
              >
                {c.label} <span class="opacity-70">({categoryCounts.get(c.id)})</span>
              </button>
            ))
          }
        </div>
        <div
          class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 max-w-7xl mx-auto"
          id="gallery"
        >
          {
            galleryImages.map((image, index) => (
              <a
                href={image.src}
                class="glightbox group block aspect-square overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-all duration-300 bg-neutral-100 relative"
                data-gallery="gallery1"
                data-category={getCategory(image.src)}
                data-title={image.title}
                data-description={image.description}
              >
                <Image
                  src={image.src}
                  alt={`${image.title} — ${image.description}`}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                  width={400}
                  height={400}
                  inferSize
                  loading={index < 8 ? 'eager' : 'lazy'}
                />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-3 pt-8 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <p class="text-white text-sm font-semibold leading-tight">{image.title}</p>
                  <p class="text-white/80 text-xs mt-0.5 leading-snug">{image.description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 font-display tracking-tight">
          Ready to Start Your Project?
        </h2>
        <p class="text-neutral-700 mb-8 max-w-2xl mx-auto leading-relaxed">
          Let us bring your flooring vision to life. Contact us today for a free estimate.
        </p>
        <a
          href="/contact"
          class="inline-block bg-brand-accent text-white px-10 py-4 rounded-lg font-semibold hover:bg-brand-accent-dark transition duration-300 text-lg shadow-lg"
        >
          Get Your Free Estimate
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import GLightbox from 'glightbox';

  // Escape closes the lightbox, arrow keys navigate between slides.
  // Only items that are currently visible (not filtered out) are included.
  function createLightbox() {
    return GLightbox({
      selector: '#gallery a.glightbox:not([hidden])',
      touchNavigation: true,
      keyboardNavigation: true,
      closeOnOutsideClick: true,
      loop: true,
      autoplayVideos: false,
      closeButton: true,
      moreLength: 0,
    });
  }

  let lightbox = createLightbox();

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('#gallery a.glightbox'));

  function applyFilter(filter: string) {
    for (const item of items) {
      item.hidden = filter !== 'all' && item.dataset.category !== filter;
    }
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
    }
    lightbox.destroy();
    lightbox = createLightbox();
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      applyFilter(filter);
      history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
    });
  }

  // Support direct links like /gallery#tile
  const initial = location.hash.slice(1);
  if (initial && buttons.some((b) => b.dataset.filter === initial)) {
    applyFilter(initial);
  }
</script>

<style>
  /* Ensure images display properly */
  img {
    display: block;
  }

  /* Filter pills */
  .filter-btn {
    background: white;
    color: var(--color-neutral-700);
    border-color: var(--color-neutral-300);
  }
  .filter-btn:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }
  .filter-btn[aria-pressed='true'] {
    background: var(--color-brand-primary);
    border-color: var(--color-brand-primary);
    color: white;
  }

  /* Tailwind's `block` utility would otherwise override the hidden attribute */
  #gallery a[hidden] {
    display: none;
  }
</style>
