  '/images/tile-shower-marble-look-large-format-hex-floor-bench.jpg',
  '/images/hardwood-light-oak-great-room-sunlight.jpg',
  '/images/hardwood-kitchen-light-oak-cherry-cabinets-vaulted.jpg',
  '/images/hardwood-upstairs-hallway-railing-wide-plank.jpg',
  '/images/hardwood-wide-plank-grain-warm-oak-closeup.jpg',
  '/images/tile-shower-black-brick-valve-handheld-niche.jpg',
  '/images/tile-large-format-polished-porcelain-evening-reflections.jpg',
  '/images/tile-shower-marble-look-mosaic-floor-niche-bench.jpg',
  '/images/tile-shower-black-brick-niche-rain-head-valve-drain.jpg',
  '/images/tile-large-format-great-room.jpg',
  '/images/tile-large-format-polished-porcelain-open-kitchen.jpg',
];
const featuredSet = new Set(featuredSrcs);
const featuredImages = featuredSrcs.map((src) => {
  const image = galleryImages.find((i) => i.src === src);
  if (!image) throw new Error(`Featured image missing from galleryImages: ${src}`);
  return image;
});
const orderedImages = [
  ...featuredImages,
  ...galleryImages.filter((image) => !featuredSet.has(image.src)),
];

// Gallery filter categories, derived from the image filename prefix
const categoryDefs = [
  { id: 'tile', label: 'Tile & Showers' },
  { id: 'carpet', label: 'Carpet' },
  { id: 'hardwood', label: 'Hardwood' },
  { id: 'vinyl', label: 'Vinyl Plank' },
  { id: 'concrete', label: 'Concrete' },
  { id: 'epoxy', label: 'Epoxy' },
];

function getCategory(src: string): string {
  const file = src.split('/').pop() ?? '';
  if (file.startsWith('tile-')) return 'tile';
  if (file.startsWith('carpet-')) return 'carpet';
  if (file.startsWith('hardwood-')) return 'hardwood';
  if (file.startsWith('vinyl-')) return 'vinyl';
  if (file.startsWith('epoxy-')) return 'epoxy';
  if (file.includes('concrete-')) return 'concrete';
  return 'other';
}

const categoryCounts = new Map<string, number>();
for (const image of galleryImages) {
  const category = getCategory(image.src);
  categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
}
const filterButtons = categoryDefs.filter((c) => (categoryCounts.get(c.id) ?? 0) > 0);

const galleryJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Brooks Floor Covering Project Gallery',
  description:
    'Completed flooring projects throughout the Phoenix Valley — tile, carpet, polished concrete, epoxy, and concrete overlays.',
  itemListElement: orderedImages.map((image, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'ImageObject',
      contentUrl: `https://brooksfloorcovering.com${image.src}`,
      name: image.title,
      description: image.description,
      creditText: 'Brooks Floor Covering',
    },
  })),
};
