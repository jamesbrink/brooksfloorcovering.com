---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const currentTags = post.data.tags ?? [];
    const related = posts
      .filter((other) => other.id !== post.id)
      .map((other) => ({
        post: other,
        sharedTags: (other.data.tags ?? []).filter((tag) => currentTags.includes(tag)).length,
      }))
      .sort((a, b) => {
        if (b.sharedTags !== a.sharedTags) return b.sharedTags - a.sharedTags;
        return b.post.data.date.getTime() - a.post.data.date.getTime();
      })
      .slice(0, 3)
      .map((entry) => entry.post);

    return {
      params: { slug: post.id },
      props: { post, related },
    };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const slug = post.id;

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isoDate = post.data.date.toISOString().split('T')[0];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://brooksfloorcovering.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://brooksfloorcovering.com/blog/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: `https://brooksfloorcovering.com/blog/${slug}/`,
    },
  ],
};

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate,
  dateModified: isoDate,
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: 'https://brooksfloorcovering.com/',
  },
  publisher: {
    '@id': 'https://brooksfloorcovering.com/#business',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://brooksfloorcovering.com/blog/${slug}/`,
  },
  ...(post.data.image && {
    image: `https://brooksfloorcovering.com${post.data.image}`,
  }),
};
---

<Layout
  title={`${post.data.title} - Brooks Floor Covering`}
  description={post.data.description}
  jsonLd={[breadcrumbJsonLd, blogPostingJsonLd]}
  ogImage={post.data.image}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
>
  <Navigation />

  <div class="pt-20 bg-gradient-to-br from-brand-dark to-brand-navy"></div>

  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'Blog', href: '/blog/' },
      { label: post.data.title },
    ]}
  />

  <main>
    <article class="py-12 md:py-16 bg-white">
      <div class="container mx-auto px-4 max-w-3xl">
        <!-- Article Header -->
        <header class="mb-10">
          <div class="flex items-center gap-3 text-sm text-neutral-500 mb-4">
            <time datetime={isoDate}>{formattedDate}</time>
            <span aria-hidden="true">&middot;</span>
            <span>{post.data.author}</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold font-display text-neutral-900 mb-4">
            {post.data.title}
          </h1>
          {
            post.data.tags && (
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="text-xs bg-blue-50 text-brand-primary px-2 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            )
          }
        </header>

        <!-- Hero Image -->
        {
          post.data.image && (
            <img
              src={post.data.image}
              alt={post.data.title}
              class="w-full rounded-lg shadow-md mb-10"
              loading="eager"
            />
          )
        }

        <!-- Article Content -->
        <div class="prose">
          <Content />
        </div>

        <!-- CTA Banner -->
        <div
          class="mt-12 bg-gradient-to-br from-brand-dark to-brand-navy rounded-xl p-8 text-center text-white"
        >
          <h2 class="text-2xl font-bold font-display mb-3">Ready to Get Started?</h2>
          <p class="text-lg opacity-90 mb-6 max-w-xl mx-auto">
            Contact us today for a free estimate on your flooring project. Serving the Greater
            Phoenix Area since 1994.
          </p>
          <a
            href="/contact/"
            class="inline-block bg-brand-accent text-white px-8 py-3 rounded-lg font-semibold hover:bg-brand-accent-dark transition duration-300 shadow-lg"
          >
            Get a Free Estimate
          </a>
        </div>

        <!-- Related Posts -->
        {
          related.length > 0 && (
            <div class="mt-12 border-t border-neutral-200 pt-8">
              <h3 class="text-lg font-bold text-neutral-900 mb-4">Related Articles</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {related.map((relatedPost) => (
                  <a
                    href={`/blog/${relatedPost.id}/`}
                    class="block bg-white rounded-lg border border-neutral-200 shadow-sm hover:shadow-md transition-shadow duration-300 p-5"
                  >
                    <time
                      datetime={relatedPost.data.date.toISOString().split('T')[0]}
                      class="text-xs text-neutral-500"
                    >
                      {relatedPost.data.date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    <h4 class="text-base font-bold font-display text-neutral-900 mt-1 mb-2">
                      {relatedPost.data.title}
                    </h4>
                    <p class="text-sm text-neutral-600 leading-relaxed">
                      {relatedPost.data.description}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <!-- Related Services -->
        <div class="mt-12 border-t border-neutral-200 pt-8">
          <h3 class="text-lg font-bold text-neutral-900 mb-4">Explore Our Services</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <a
              href="/services/tile/"
              class="block text-center px-4 py-3 bg-neutral-50 rounded-lg text-sm font-medium text-neutral-700 hover:text-brand-primary hover:bg-blue-50 transition-colors"
            >
              Tile
            </a>
            <a
              href="/services/luxury-vinyl-plank/"
              class="block text-center px-4 py-3 bg-neutral-50 rounded-lg text-sm font-medium text-neutral-700 hover:text-brand-primary hover:bg-blue-50 transition-colors"
            >
              Luxury Vinyl Plank
            </a>
            <a
              href="/services/polished-concrete/"
              class="block text-center px-4 py-3 bg-neutral-50 rounded-lg text-sm font-medium text-neutral-700 hover:text-brand-primary hover:bg-blue-50 transition-colors"
            >
              Polished Concrete
            </a>
            <a
              href="/services/engineered-hardwood/"
              class="block text-center px-4 py-3 bg-neutral-50 rounded-lg text-sm font-medium text-neutral-700 hover:text-brand-primary hover:bg-blue-50 transition-colors"
            >
              Engineered Hardwood
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
