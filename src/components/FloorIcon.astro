---
// Simple line icons for flooring types, drawn to match what each card describes.
export type FloorIconName =
  | 'carpet'
  | 'plank'
  | 'hardwood'
  | 'vinyl-sheet'
  | 'tile'
  | 'polished'
  | 'epoxy'
  | 'laminate'
  | 'shower'
  | 'prep';

interface Props {
  name: FloorIconName | (string & {});
  class?: string;
}

const { name, class: className = 'w-7 h-7' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'carpet' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <path d="M12 3v18M3 12h18" />
        <path d="M5.5 9.5l4-4M5.5 7l1.5-1.5M14.5 18.5l4-4M14.5 16l1.5-1.5M8 9.5l1.5-1.5M17 18.5l1.5-1.5" />
      </>
    )
  }
  {
    name === 'plank' && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="1.5" />
        <path d="M3 9.3h18M3 14.7h18M13 4v5.3M8 9.3v5.4M16 14.7V20" />
      </>
    )
  }
  {
    name === 'hardwood' && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="1.5" />
        <path d="M3 9.3h18M3 14.7h18M13 4v5.3M8 9.3v5.4M16 14.7V20" />
        <path d="M5.5 6.7c1.4-.9 2.6.9 4 0M15 6.7c1.2-.8 2.2.8 3.4 0M10.5 12c1.3-.9 2.5.9 3.8 0M4.8 17.4c1.3-.8 2.4.8 3.6 0M18 12c.6-.4 1.1.2 1.6 0" />
      </>
    )
  }
  {
    name === 'vinyl-sheet' && (
      <>
        <path d="M4 6h14M4 18h14" />
        <path d="M4 6a3 6 0 0 0 0 12" />
        <ellipse cx="18" cy="12" rx="3" ry="6" />
        <ellipse cx="18" cy="12" rx="1" ry="2" />
      </>
    )
  }
  {
    name === 'tile' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <path d="M9 3v18M15 3v18M3 9h18M3 15h18" />
      </>
    )
  }
  {
    name === 'polished' && (
      <>
        <path d="M12 2l1.6 4.4L18 8l-4.4 1.6L12 14l-1.6-4.4L6 8l4.4-1.6z" />
        <path d="M3 18h18M6 21h12" />
      </>
    )
  }
  {
    name === 'epoxy' && (
      <>
        <path d="M12 3s6 6.2 6 10.5a6 6 0 0 1-12 0C6 9.2 12 3 12 3z" />
        <path d="M9.5 14a3 3 0 0 0 2.5 2.5" />
      </>
    )
  }
  {
    name === 'laminate' && (
      <>
        <path d="M12 3l9 5-9 5-9-5z" />
        <path d="M3 12l9 5 9-5M3 16l9 5 9-5" />
      </>
    )
  }
  {
    name === 'shower' && (
      <>
        <path d="M4 11a8 8 0 0 1 16 0z" />
        <path d="M8 15v2M12 15v4M16 15v2M10 21v0M14 21v0" />
      </>
    )
  }
  {
    name === 'prep' && (
      <>
        <rect x="3" y="12" width="18" height="4" rx="1" />
        <path d="M12 12V8a2 2 0 0 1 2-2h3" />
        <path d="M3 20h18" />
      </>
    )
  }
</svg>
